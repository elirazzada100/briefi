{
  "name": "Generation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05ea\u05de\u05e9"
    },
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "generateCreativeDNA",
        "generateHooks",
        "generateBodyOptions",
        "generateCTAOptions",
        "assembleFinalBrief",
        "rewriteOption"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "model": {
      "type": "string",
      "description": "\u05de\u05d5\u05d3\u05dc AI"
    },
    "input_payload": {
      "type": "object",
      "description": "\u05e7\u05dc\u05d8"
    },
    "output_payload": {
      "type": "object",
      "description": "\u05e4\u05dc\u05d8"
    },
    "input_tokens": {
      "type": "number",
      "description": "\u05d8\u05d5\u05e7\u05e0\u05d9\u05dd \u05d1\u05e7\u05dc\u05d8"
    },
    "output_tokens": {
      "type": "number",
      "description": "\u05d8\u05d5\u05e7\u05e0\u05d9\u05dd \u05d1\u05e4\u05dc\u05d8"
    },
    "estimated_cost_usd": {
      "type": "number",
      "description": "\u05e2\u05dc\u05d5\u05ea \u05de\u05e9\u05d5\u05e2\u05e8\u05ea \u05d1\u05d3\u05d5\u05dc\u05e8"
    },
    "success": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05e6\u05dc\u05d9\u05d7"
    },
    "error_message": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05ea \u05e9\u05d2\u05d9\u05d0\u05d4"
    }
  },
  "required": [
    "action_type"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}