{
  "name": "LockedHookTemplates",
  "type": "object",
  "properties": {
    "hook_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d5\u05e7 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05de\u05d4\u05e7\u05d5\u05d1\u05e5 (hook_0001 \u05d5\u05db\u05d5')"
    },
    "source_order": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9 \u05de\u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "source_category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05de\u05e7\u05d5\u05e8 (general, educational, comparison \u05d5\u05db\u05d5')"
    },
    "original_language": {
      "type": "string",
      "description": "\u05e9\u05e4\u05ea \u05d4\u05de\u05e7\u05d5\u05e8 (he/en)"
    },
    "original_template": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05d4\u05d4\u05d5\u05e7 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea"
    },
    "hebrew_template": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05d4\u05d4\u05d5\u05e7 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea \u2014 \u05d6\u05d4 \u05de\u05d4 \u05e9\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d5"
    },
    "hook_mechanic": {
      "type": "string",
      "description": "\u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e8\u05d2\u05e9\u05d9 \u05e9\u05dc \u05d4\u05d4\u05d5\u05e7"
    },
    "best_for_styles": {
      "type": "string",
      "description": "\u05e1\u05d2\u05e0\u05d5\u05e0\u05d5\u05ea \u05e1\u05e8\u05d8\u05d5\u05df \u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd (all \u05d0\u05d5 \u05e8\u05e9\u05d9\u05de\u05d4)"
    },
    "best_for_industries": {
      "type": "string",
      "description": "\u05ea\u05e2\u05e9\u05d9\u05d5\u05ea \u05de\u05ea\u05d0\u05d9\u05de\u05d5\u05ea (all \u05d0\u05d5 \u05e8\u05e9\u05d9\u05de\u05d4)"
    },
    "placeholder_slots": {
      "type": "string",
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05e9\u05ea\u05e0\u05d9\u05dd \u05dc\u05d4\u05d7\u05dc\u05e4\u05d4"
    },
    "source_file": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8"
    },
    "source_batch": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4-batch \u05e9\u05dc \u05d4\u05d9\u05d9\u05d1\u05d5\u05d0"
    },
    "is_locked": {
      "type": "boolean",
      "default": true,
      "description": "\u05e0\u05e2\u05d5\u05dc \u2014 \u05dc\u05d0 \u05dc\u05e2\u05e8\u05d9\u05db\u05d4"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "hook_id",
    "hebrew_template"
  ]
}