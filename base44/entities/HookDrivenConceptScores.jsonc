{
  "name": "HookDrivenConceptScores",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "generation_run_id": {
      "type": "string"
    },
    "hook_template_fit_score": {
      "type": "number",
      "default": 0
    },
    "style_fit_score": {
      "type": "number",
      "default": 0
    },
    "specificity_score": {
      "type": "number",
      "default": 0
    },
    "talking_head_strength_score": {
      "type": "number",
      "default": 0
    },
    "business_fit_score": {
      "type": "number",
      "default": 0
    },
    "israeli_voice_score": {
      "type": "number",
      "default": 0
    },
    "innovation_score": {
      "type": "number",
      "default": 0
    },
    "high_energy_score": {
      "type": "number",
      "default": 0
    },
    "shootability_score": {
      "type": "number",
      "default": 0
    },
    "shareability_score": {
      "type": "number",
      "default": 0
    },
    "generic_penalty": {
      "type": "number",
      "default": 0
    },
    "final_score": {
      "type": "number",
      "default": 0
    },
    "decision": {
      "type": "string",
      "enum": [
        "keep",
        "rewrite",
        "reject"
      ],
      "default": "keep"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "generation_run_id"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "data.owner_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_id": "{{user.id}}"
    }
  }
}