{
  "name": "VideoBrief",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "video_number": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e1\u05e8\u05d8\u05d5\u05df"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e1\u05e8\u05d8\u05d5\u05df"
    },
    "selected_hook": {
      "type": "object",
      "description": "\u05d4\u05d4\u05d5\u05e7 \u05e9\u05e0\u05d1\u05d7\u05e8"
    },
    "selected_body": {
      "type": "object",
      "description": "\u05de\u05d1\u05e0\u05d4 \u05d4\u05d2\u05d5\u05e3 \u05e9\u05e0\u05d1\u05d7\u05e8"
    },
    "selected_cta": {
      "type": "object",
      "description": "CTA \u05e9\u05e0\u05d1\u05d7\u05e8"
    },
    "final_brief": {
      "type": "object",
      "description": "\u05d4\u05d1\u05e8\u05d9\u05e3 \u05d4\u05e1\u05d5\u05e4\u05d9"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "edited",
        "approved"
      ],
      "default": "draft",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e8\u05d9\u05e3"
    }
  },
  "required": [
    "project_id"
  ]
}