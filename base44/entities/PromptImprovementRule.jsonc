{
  "name": "PromptImprovementRule",
  "type": "object",
  "properties": {
    "industry": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "rule_text": {
      "type": "string",
      "description": "\u05db\u05dc\u05dc"
    },
    "bad_example": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d2\u05de\u05d4 \u05e8\u05e2\u05d4"
    },
    "good_example": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d2\u05de\u05d4 \u05d8\u05d5\u05d1\u05d4"
    },
    "source_feedback_count": {
      "type": "number",
      "default": 1
    },
    "confidence_score": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "rule_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}