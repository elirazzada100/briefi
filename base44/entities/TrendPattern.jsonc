{
  "name": "TrendPattern",
  "type": "object",
  "properties": {
    "trend_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d8\u05e8\u05e0\u05d3"
    },
    "category_fit": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05de\u05ea\u05d0\u05d9\u05de\u05d5\u05ea"
    },
    "platform": {
      "type": "string",
      "enum": [
        "TikTok",
        "Reels",
        "Shorts",
        "General"
      ],
      "description": "\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05d4"
    },
    "structure": {
      "type": "string",
      "description": "\u05de\u05d1\u05e0\u05d4"
    },
    "how_to_adapt": {
      "type": "string",
      "description": "\u05d0\u05d9\u05da \u05dc\u05d4\u05ea\u05d0\u05d9\u05dd"
    },
    "example_hebrew": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d2\u05de\u05d4 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea"
    },
    "risk_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e1\u05d9\u05db\u05d5\u05df"
    },
    "freshness_status": {
      "type": "string",
      "enum": [
        "current",
        "stable",
        "outdated"
      ],
      "default": "stable",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d5\u05ea"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "trend_name",
    "structure"
  ]
}