{
  "name": "BriefQualityCheck",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "video_brief_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e8\u05d9\u05e3"
    },
    "overall_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05db\u05d5\u05dc\u05dc 1-10"
    },
    "hook_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d4\u05d5\u05e7"
    },
    "concept_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05e7\u05d5\u05e0\u05e1\u05e4\u05d8"
    },
    "script_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05e1\u05e7\u05e8\u05d9\u05e4\u05d8"
    },
    "clarity_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d1\u05d4\u05d9\u05e8\u05d5\u05ea"
    },
    "israeli_tone_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d8\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9"
    },
    "client_safe_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05dc\u05e7\u05d5\u05d7"
    },
    "shootability_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d9\u05e9\u05d9\u05de\u05d5\u05ea \u05e6\u05d9\u05dc\u05d5\u05dd"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d1\u05e2\u05d9\u05d5\u05ea \u05e9\u05e0\u05de\u05e6\u05d0\u05d5"
    },
    "fix_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d4\u05e6\u05e2\u05d5\u05ea \u05dc\u05ea\u05d9\u05e7\u05d5\u05df"
    },
    "needs_rewrite": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d3\u05e8\u05e9 \u05e9\u05db\u05ea\u05d5\u05d1"
    },
    "was_improved": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e9\u05d5\u05e4\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea"
    }
  },
  "required": [
    "project_id",
    "video_brief_id"
  ]
}