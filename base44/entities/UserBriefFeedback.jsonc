{
  "name": "UserBriefFeedback",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "video_brief_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e8\u05d9\u05e3"
    },
    "rating_label": {
      "type": "string",
      "description": "\u05ea\u05d5\u05d5\u05d9\u05ea \u05d3\u05d9\u05e8\u05d5\u05d2"
    },
    "rating_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df 1-5"
    },
    "selected_feedback_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05d2\u05d9\u05d5\u05ea \u05e4\u05d9\u05d3\u05d1\u05e7"
    },
    "free_text_negative": {
      "type": "string",
      "description": "\u05de\u05d4 \u05dc\u05d0 \u05e2\u05d1\u05d3"
    },
    "free_text_positive": {
      "type": "string",
      "description": "\u05de\u05d4 \u05db\u05df \u05e2\u05d1\u05d3"
    },
    "industry": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "concept_title": {
      "type": "string"
    },
    "hook_text": {
      "type": "string"
    },
    "model_used": {
      "type": "string"
    },
    "source_batch_version": {
      "type": "string",
      "default": "v4"
    }
  },
  "required": [
    "project_id",
    "video_brief_id"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "data.owner_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_id": "{{user.id}}"
    }
  }
}