{
  "name": "SpokenLine",
  "type": "object",
  "properties": {
    "industry": {
      "type": "string",
      "description": "\u05ea\u05e2\u05e9\u05d9\u05d9\u05d4"
    },
    "line_type": {
      "type": "string",
      "enum": [
        "customer",
        "seller",
        "friend",
        "date",
        "owner",
        "narrator",
        "CTA"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d3\u05de\u05d5\u05ea"
    },
    "line_text": {
      "type": "string",
      "description": "\u05d4\u05d8\u05e7\u05e1\u05d8"
    },
    "context": {
      "type": "string",
      "description": "\u05d4\u05e7\u05e9\u05e8"
    },
    "tone": {
      "type": "string",
      "description": "\u05d8\u05d5\u05df"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "source_batch": {
      "type": "string",
      "description": "\u05de\u05e7\u05d5\u05e8"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "line_text",
    "line_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}