{
  "name": "VoiceRule",
  "type": "object",
  "properties": {
    "rule_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05db\u05dc\u05dc"
    },
    "category": {
      "type": "string",
      "enum": [
        "global",
        "\u05de\u05e6\u05d7\u05d9\u05e7",
        "\u05ea\u05d3\u05de\u05d9\u05ea",
        "\u05e1\u05e8\u05d8\u05d5\u05df \u05d0\u05d5\u05d5\u05d9\u05e8\u05d4",
        "\u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05d9\u05db\u05e8\u05d5\u05ea",
        "\u05de\u05db\u05d9\u05e8\u05ea\u05d9",
        "\u05db\u05d0\u05d1 / \u05e4\u05ea\u05e8\u05d5\u05df",
        "\u05d8\u05e8\u05e0\u05d3\u05d9"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "prefer",
        "avoid",
        "allow",
        "warning"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05db\u05dc\u05dc"
    },
    "rule_text": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05db\u05dc\u05dc"
    },
    "example_good": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d2\u05de\u05d4 \u05d8\u05d5\u05d1\u05d4"
    },
    "example_bad": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d2\u05de\u05d4 \u05e8\u05e2\u05d4"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "rule_name",
    "rule_text"
  ]
}