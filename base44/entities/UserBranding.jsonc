    },
    "display_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05ea\u05e6\u05d5\u05d2\u05d4"
    },
    "business_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e2\u05e1\u05e7 / \u05e1\u05d5\u05db\u05e0\u05d5\u05ea"
    },
    "logo_url": {
      "type": "string",
