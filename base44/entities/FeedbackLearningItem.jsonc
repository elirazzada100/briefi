{
  "name": "FeedbackLearningItem",
  "type": "object",
  "properties": {
    "source_feedback_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05d9\u05d3\u05d1\u05e7 \u05de\u05e7\u05d5\u05e8"
    },
    "industry": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "learning_type": {
      "type": "string",
      "enum": [
        "bad_pattern",
        "good_pattern",
        "spoken_line",
        "rewrite_rule",
        "anti_pattern",
        "brief_example",
        "voice_sample"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05dc\u05de\u05d9\u05d3\u05d4"
    },
    "problem_detected": {
      "type": "string",
      "description": "\u05d1\u05e2\u05d9\u05d4 \u05e9\u05d6\u05d5\u05d4\u05ea\u05d4"
    },
    "suggested_fix": {
      "type": "string",
      "description": "\u05ea\u05d9\u05e7\u05d5\u05df \u05de\u05d5\u05e6\u05e2"
    },
    "example_bad": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d2\u05de\u05d4 \u05e8\u05e2\u05d4"
    },
    "example_better": {
      "type": "string",
      "description": "\u05d3\u05d5\u05d2\u05de\u05d4 \u05d8\u05d5\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8"
    },
    "confidence_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d1\u05d9\u05d8\u05d7\u05d5\u05df 0-1"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_admin_review",
        "approved",
        "rejected",
        "auto_applied_low_risk"
      ],
      "default": "pending_admin_review",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "reviewed_by": {
      "type": "string",
      "description": "\u05e0\u05d1\u05d3\u05e7 \u05e2\u05dc \u05d9\u05d3\u05d9"
    }
  },
  "required": [
    "learning_type",
    "problem_detected"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}